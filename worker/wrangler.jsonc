{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "get-set-go-api",
  "main": "src/minimal-entry.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "keep_vars": true,
  "secrets": {
    "required": ["MODEL_API_KEY"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "FRONTEND_ORIGIN": "https://get-set-go.pages.dev",
    "MUSE_SPARK_MODEL": "muse-spark-1.3",
    "MUSE_IMAGE_MODEL": "muse-image-1.0"
  }
}
